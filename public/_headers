# Cloudflare Workers static assets headers: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Workers assets join values when two matching rules set the same header, so
# each header name is set in exactly one rule.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Vite build output has a content hash in the file name, so it never changes
# under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Election data keeps fixed URLs across rebuilds. A short cache avoids
# refetching megabytes on every visit and still picks up new data within
# an hour.
/data/*
  Cache-Control: public, max-age=3600
